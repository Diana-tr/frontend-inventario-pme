<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ignorar reescritura para archivos y directorios reales (assets)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # 1. Regla para entorno local XAMPP (cuando se accede vía localhost o 127.0.0.1 con subdirectorio)
    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ /frontend-inventario-pme/index.php [QSA,L]

    # 2. Regla para entorno de producción (Hosting remoto como InfinityFree en la raíz del dominio)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

